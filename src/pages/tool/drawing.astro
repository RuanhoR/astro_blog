---
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import DrawingCanvas from "../../components/drawing/DrawingCanvas.svelte";
import ColorPicker from "../../components/drawing/ColorPicker.svelte";
import BrushSelector from "../../components/drawing/BrushSelector.svelte";
import ShapeSelector from "../../components/drawing/ShapeSelector.svelte";
import ImageImporter from "../../components/drawing/ImageImporter.svelte";
import { i18n } from "../../i18n/translation";
import Key from "../../i18n/i18nKey";
---

<MainGridLayout title={i18n(Key.drawingTool)} description={i18n(Key.drawingTool)}>
  <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
    <div class="card-base z-10 px-9 py-6 relative w-full">
      <h1 class="text-2xl font-bold mb-6 text-90">{i18n(Key.drawingTool)}</h1>
      <div class="drawing-app">
        <div class="toolbar">
          <ColorPicker selectedColor="#000000" client:only />
          <BrushSelector client:only />
          <ShapeSelector client:only />
          <ImageImporter client:only />
        </div>
        <DrawingCanvas width={800} height={600} client:only />
      </div>
    </div>
  </div>
</MainGridLayout>

<style>
  .drawing-app {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem;
    border-radius: var(--radius-large);
    border: 1px solid var(--btn-regular-bg);
  }
  @media (max-width: 768px) {
    .toolbar {
      flex-direction: column;
    }
  }
</style>